{
	"$schema": "https://schemas.wp.org/trunk/wp-env.json",
	"core": "WordPress/WordPress#7.1.2",
	"phpVersion": "8.3",
	"testsEnvironment": false,
	"plugins": [
		"https://downloads.wordpress.org/plugin/woocommerce.11.1.2.zip",
		"./cjenik-i-sidrena-cijena"
	],
	"mappings": {
		"cjenik-dev": "./dev",
		"cjenik-release": "./release/php"
	},
	"config": {
		"WP_DEBUG_LOG": true,
		"WP_DEBUG_DISPLAY": false
	},
	"lifecycleScripts": {
		"afterStart": "npx wp-env run cli wp eval-file cjenik-dev/seed.php"
	}
}
