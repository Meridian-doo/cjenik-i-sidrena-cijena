# Files and folders left out of the release zip (npm run build).
# A leading "/" anchors the pattern to the plugin folder; otherwise it matches
# a file or folder name anywhere. "*" matches within one name.
/.distignore
/.phpunit.result.cache
/bin
/tests
/vendor
/composer.lock
/phpunit.xml.dist
/phpcs.xml.dist
/phpstan.neon.dist
.DS_Store
