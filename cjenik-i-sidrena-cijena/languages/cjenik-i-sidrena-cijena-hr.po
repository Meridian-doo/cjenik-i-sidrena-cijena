msgstr "Npr. 0,25 za 250 g kad je jedinica mjere kg. Cijena za jedinicu mjere je maloprodajna cijena podijeljena ovim brojem."

#: src/Admin/ProductFields.php:149
msgid "No anchor yet. It is set from the price history once the product is published, or enter it here."
msgstr "Sidrena cijena još nije postavljena. Postavit će se iz povijesti cijena kad se proizvod objavi, a možete je unijeti i ovdje."

#. translators: %s: date
#: src/Admin/ProductFields.php:155
#, php-format
msgid "Entered by hand, for %s. Clear both fields to use the price history."
msgstr "Uneseno ručno, za %s. Ispraznite oba polja ako želite koristiti povijest cijena."

#. translators: %s: date
#: src/Admin/ProductFields.php:158
#, php-format
msgid "Imported from CSV, for %s. Clear both fields to use the price history."
msgstr "Uvezeno iz CSV-a, za %s. Ispraznite oba polja ako želite koristiti povijest cijena."

#. translators: %s: date
#: src/Admin/ProductFields.php:162
#, php-format
